{
    "name": "lauroguedes/astro-on-laravel",
    "description": "Keep an Astro landing page in the same repository as your Laravel application, scaffold it with one command, run it alongside `composer run dev`, and deploy it on its own.",
    "keywords": [
        "laravel",
        "astro",
        "landing-page",
        "static-site",
        "marketing-site",
        "github-actions"
    ],
    "homepage": "https://github.com/lauroguedes/astro-on-laravel",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/lauroguedes/astro-on-laravel/issues",
        "source": "https://github.com/lauroguedes/astro-on-laravel",
        "docs": "https://github.com/lauroguedes/astro-on-laravel/blob/main/docs/README.md",
        "security": "https://github.com/lauroguedes/astro-on-laravel/security/policy"
    },
    "funding": [
        {
            "type": "custom",
            "url": "https://buymeacoffee.com/lauroguedes"
        }
    ],
    "authors": [
        {
            "name": "Lauro Guedes",
            "email": "laurowguedes@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/process": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/prompts": "^0.3.5"
    },
    "require-dev": {
        "larastan/larastan": "^3.4",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0|^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "rector/rector": "^2.0",
        "symfony/yaml": "^7.2|^8.0"
    },
    "autoload": {
        "psr-4": {
            "LauroGuedes\\AstroOnLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LauroGuedes\\AstroOnLaravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "lint": [
            "@php vendor/bin/pint --parallel",
            "@php vendor/bin/rector"
        ],
        "test:lint": [
            "@php vendor/bin/pint --parallel --test",
            "@php vendor/bin/rector --dry-run"
        ],
        "test:types": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "test:type-coverage": "@php -d memory_limit=1G vendor/bin/pest --type-coverage --min=100",
        "test:unit": "@php vendor/bin/pest",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ]
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LauroGuedes\\AstroOnLaravel\\AstroOnLaravelServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
