name: {{ name }}

# Builds the Astro landing in {{ path }}/ and deploys it to your own server over SSH.
# Generated by lauroguedes/laravel-astro-landing. Only changes under {{ path }}/
# (or to this file) trigger it, so the Laravel application and the landing
# ship independently from the same repository.

on:
  push:
    branches: [{{ branch }}]
    paths:
      - '{{ path }}/**'
      - '.github/workflows/{{ workflow_file }}'
  workflow_dispatch:

# A newer push waits for the running deploy instead of cancelling it: a
# deploy stopped halfway can leave the site with half its files.
concurrency:
  group: ${{ github.workflow }}
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: {{ path }}
    steps:
      - name: Checkout code
        uses: actions/checkout@v7

{{ setup }}

      # LANDING_URL is a repository variable (Settings → Secrets and variables →
      # Actions → Variables): where visitors reach the landing, e.g.
      # https://example.com, or https://example.com/lp/ under a path. Its origin
      # is passed to Astro as --site, which canonical links, Open Graph URLs,
      # the sitemap and robots.txt are built from, whatever the template's own
      # config says. The path, if any, comes from `base` in astro.config.
      - name: Build landing
        env:
          LANDING_URL: ${{ vars.LANDING_URL }}
          # Anything else the landing reads at build time goes here too:
          # PUBLIC_APP_URL: ${{ vars.PUBLIC_APP_URL }}
        run: |
          if [ -z "$LANDING_URL" ]; then
            echo "::error::Set the LANDING_URL repository variable to the landing's public URL, e.g. https://example.com. Canonical links, Open Graph and the sitemap are built from it."
            exit 1
          fi
          SITE=$(printf '%s' "$LANDING_URL" | sed -E 's#^(https?://[^/]+).*#\1#')
          {{ build_with_site }}

      # A canonical link pointing at another domain tells search engines to
      # index that domain instead of this one, so a build that still points at
      # a template's placeholder, or anywhere but LANDING_URL, is not deployed.
      - name: Check SEO URLs
        env:
          LANDING_URL: ${{ vars.LANDING_URL }}
        run: |
          SITE=$(printf '%s' "$LANDING_URL" | sed -E 's#^(https?://[^/]+).*#\1#')
          if [ "$SITE" != "https://example.com" ] && grep -rlF --include='*.html' --include='*.xml' --include='*.txt' 'https://example.com' dist; then
            echo "::error::The files above still point at https://example.com. The template sets its URL somewhere --site does not reach; set it from LANDING_URL."
            exit 1
          fi
          CANONICAL=$(grep -oE '<link[^>]+rel="?canonical"?[^>]*>' dist/index.html 2>/dev/null | grep -oE 'href="?[^" >]+' | head -1 | sed -E 's/^href="?//')
          if [ -z "$CANONICAL" ]; then
            echo "::warning::dist/index.html has no canonical link. docs/seo.md in lauroguedes/laravel-astro-landing shows how to add one."
          elif [ "${CANONICAL#"$SITE/"}" = "$CANONICAL" ]; then
            echo "::error::The home page's canonical link is $CANONICAL, which is not on $SITE."
            exit 1
          fi

      - name: Deploy over SSH
        env:
          SSH_HOST: ${{ secrets.LANDING_SSH_HOST }}
          SSH_PORT: ${{ secrets.LANDING_SSH_PORT || '22' }}
          SSH_USER: ${{ secrets.LANDING_SSH_USER }}
          SSH_KEY: ${{ secrets.LANDING_SSH_KEY }}
          SSH_PATH: ${{ secrets.LANDING_SSH_PATH }}
          # Optional: the server's line from known_hosts. Without it the host
          # key is taken from the server on every run, which trusts whatever
          # answers at that address.
          SSH_KNOWN_HOSTS: ${{ secrets.LANDING_SSH_KNOWN_HOSTS }}
        run: |
          install -m 700 -d ~/.ssh
          printf '%s\n' "$SSH_KEY" > ~/.ssh/landing_deploy
          chmod 600 ~/.ssh/landing_deploy
          if [ -n "$SSH_KNOWN_HOSTS" ]; then
            printf '%s\n' "$SSH_KNOWN_HOSTS" >> ~/.ssh/known_hosts
          else
            ssh-keyscan -p "$SSH_PORT" -H "$SSH_HOST" >> ~/.ssh/known_hosts
          fi
          rsync -az --delete \
            -e "ssh -i ~/.ssh/landing_deploy -p $SSH_PORT" \
            dist/ "$SSH_USER@$SSH_HOST:$SSH_PATH"
