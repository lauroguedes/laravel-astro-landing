name: {{ name }}

# Builds the Astro landing in {{ path }}/ and deploys it to GitHub Pages.
# Generated by lauroguedes/laravel-astro-landing. Only changes under {{ path }}/
# (or to this file) trigger it, so the Laravel application and the landing
# ship independently from the same repository.

on:
  push:
    branches: [{{ branch }}]
    paths:
      - '{{ path }}/**'
      - '.github/workflows/{{ workflow_file }}'
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}
  cancel-in-progress: true

permissions:
  contents: read
  pages: write
  id-token: write

jobs:
  build:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: {{ path }}
    steps:
      - name: Checkout code
        uses: actions/checkout@v6

{{ setup }}

      - name: Build landing
        # Values for astro.config.mjs or astro:env go here, read from the
        # repository's Actions variables (Settings → Secrets and variables).
        # env:
        #   PUBLIC_APP_URL: ${{ vars.PUBLIC_APP_URL }}
        run: {{ build }}

      - name: Upload artifact
        uses: actions/upload-pages-artifact@v4
        with:
          path: {{ path }}/dist

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
