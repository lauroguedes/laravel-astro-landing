name: {{ name }}

# Builds the Astro landing in {{ path }}/ and deploys it to Vercel.
# Generated by lauroguedes/laravel-astro-landing. Only changes under {{ path }}/
# (or to this file) trigger it, so the Laravel application and the landing
# ship independently from the same repository.

on:
  push:
    branches: [{{ branch }}]
    paths:
      - '{{ path }}/**'
      - '.github/workflows/{{ workflow_file }}'
  workflow_dispatch:

# A newer push waits for the running deploy instead of cancelling it: a
# deploy stopped halfway can leave the site with half its files.
concurrency:
  group: ${{ github.workflow }}
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: {{ path }}
    steps:
      - name: Checkout code
        uses: actions/checkout@v7

{{ setup }}

      - name: Build landing
        # Values for astro.config.mjs or astro:env go here, read from the
        # repository's Actions variables (Settings → Secrets and variables).
        # env:
        #   PUBLIC_APP_URL: ${{ vars.PUBLIC_APP_URL }}
        run: {{ build }}

      # The site is already built, so it goes up through Vercel's Build Output
      # API with --prebuilt: Vercel serves the files as they are and does not
      # run its own build, whatever framework the project is set to.
      - name: Deploy to Vercel
        env:
          VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
          VERCEL_ORG_ID: ${{ secrets.VERCEL_ORG_ID }}
          VERCEL_PROJECT_ID: ${{ secrets.VERCEL_PROJECT_ID }}
        run: |
          rm -rf .vercel/output
          mkdir -p .vercel/output
          cp -R dist .vercel/output/static
          echo '{"version":3}' > .vercel/output/config.json
          npx --yes vercel@latest deploy --prebuilt --prod --yes --token="$VERCEL_TOKEN"
